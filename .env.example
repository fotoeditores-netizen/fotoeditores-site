# Plantilla de variables de entorno. Copia este archivo como .env.local y llénalo.
# NUNCA pongas valores reales aquí: este archivo sí se sube a GitHub.
# En Vercel: Project → Settings → Environment Variables
#   (Preview = llaves de pruebas / Sandbox, Production = llaves reales).
#
# "Obligatoria desde Fase N": el sitio no arranca sin ella a partir de esa fase.
# La validación está en lib/env/schema.ts.

# ── Sitio ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=                 # https://fotoeditores.com (en local: http://localhost:3000)

# ── Supabase · obligatorias desde Fase 1 ─────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=             # https://<proyecto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # llave anon / publishable (pública)
SUPABASE_SERVICE_ROLE_KEY=            # ⚠️ llave service_role / secret: solo servidor, nunca en el código

# ── Wompi · Fase 4 (las 4 van juntas y del mismo ambiente) ───────────────────
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=         # pub_test_... (Sandbox) o pub_prod_... (Producción)
WOMPI_INTEGRITY_SECRET=               # ⚠️ secreto de integridad
WOMPI_EVENTS_SECRET=                  # ⚠️ secreto de eventos
WOMPI_API_BASE=                       # https://sandbox.wompi.co/v1 o https://production.wompi.co/v1

# ── WhatsApp · obligatoria desde Fase 2 ──────────────────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER=          # solo dígitos, formato internacional: 573001234567

# ── Correo (Resend) · ya en uso por /contacto y el Cotizador; obligatorio en Fase 6
RESEND_API_KEY=                       # ⚠️
EMAIL_FROM=                           # pedidos@fotoeditores.com

# ── n8n · Fase 6 ─────────────────────────────────────────────────────────────
N8N_WEBHOOK_BASE_URL=
N8N_WEBHOOK_SECRET=                   # ⚠️

# ── Medición · Fase 7 ────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_TOKEN=                      # ⚠️

# ── Anti-bots (Cloudflare Turnstile) · Fase 3 ────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=                 # ⚠️

# ── Existentes antes del funnel ──────────────────────────────────────────────
ANTHROPIC_API_KEY=                    # ⚠️ chat del sitio (/api/chat)
ELEVENLABS_API_KEY=                   # ⚠️ opcional: voz del chat (/api/tts)
PAYMENT_URL=                          # opcional: botón de pago del correo del Cotizador
